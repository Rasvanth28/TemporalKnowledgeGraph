# Copy to .env and fill in. .env is git-ignored.

# Guardian Open Platform key (free): https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Pipeline tuning (all optional; defaults shown)
SPACY_MODEL=en_core_web_sm
EXTRACT_MIN_ANCHORS=1
EXTRACT_MAX_EVENTS=5
LINK_ENTITY_WEIGHT=0.5
LINK_TOPIC_WEIGHT=0.3
LINK_DATE_WEIGHT=0.2
LINK_THRESHOLD=0.3
LINK_TOP_K=5
LINK_DATE_WINDOW_DAYS=30
LINK_WITHIN_ARTICLE=false
LINK_INFERRED_DATE_FACTOR=0.5
