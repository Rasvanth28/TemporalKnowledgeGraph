# Copy to .env and fill in. .env is git-ignored.

# Guardian Open Platform key (free): https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Pipeline tuning (all optional; defaults shown)
SPACY_MODEL=en_core_web_sm
EXTRACT_MIN_ANCHORS=1
EXTRACT_MAX_EVENTS=5
LINK_ENTITY_WEIGHT=0.5
LINK_TOPIC_WEIGHT=0.3
LINK_DATE_WEIGHT=0.2
LINK_THRESHOLD=0.3
LINK_TOP_K=5
LINK_DATE_WINDOW_DAYS=30
LINK_WITHIN_ARTICLE=false
LINK_INFERRED_DATE_FACTOR=0.5

# Neo4j (Aura is the working instance; docker-compose is an untested alternative here)
# Aura example: neo4j+s://<instance-id>.databases.neo4j.io
# Docker example: bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Aura: use NEO4J_DATABASE from the Aura credentials file (the instance id), not "neo4j".
NEO4J_DATABASE=neo4j

# Throwaway Neo4j for integration tests (wiped before every test; never your real data).
# Start it with: docker compose --profile test up -d neo4j-test
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=
NEO4J_TEST_DATABASE=neo4j

# API (graphdb.api). Comma-separated client keys sent as the X-API-Key header.
# The API refuses to start without keys unless API_AUTH_DISABLED=true (local development only).
API_KEYS=
API_AUTH_DISABLED=false
API_CORS_ORIGINS=

# Logging: LOG_FORMAT=json for one JSON object per line (production), text otherwise.
LOG_LEVEL=INFO
LOG_FORMAT=text
